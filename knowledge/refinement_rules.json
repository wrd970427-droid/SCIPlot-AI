      "keywords": [
        "宽一点",
        "再宽一点",
        "图宽一点",
        "图片变宽",
        "图变宽",
        "变宽",
        "加宽",
        "更宽",
        "widen",
        "wider",
        "make wider"
      ],
      "parameter": "width_mm",
      "operation": "multiply",
      "value": 1.2,
      "confidence": 0.85
