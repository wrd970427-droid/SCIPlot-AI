        "再窄一点",
        "图片变窄",
        "图变窄",
        "变窄",
        "更窄",
        "narrower",
        "make narrower"
      ],
      "parameter": "width_mm",
      "operation": "multiply",
      "value": 0.85,
      "confidence": 0.85
    },
    {
      "id": "nature_single",
      "keywords": ["改成Nature单栏", "Nature单栏", "nature single column", "Nature single"],
      "parameter": "nature_single_column",
      "operation": "preset",
      "value": {
