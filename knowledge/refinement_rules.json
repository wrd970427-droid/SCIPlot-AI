{
  "schema_version": "0.1.0",
  "description": "Natural-language figure design refinements → Spec parameter patches. Analysis parameters are forbidden.",
  "forbidden_paths": [
    "figure_type",
    "plot.data",
    "plot.statistics",
    "plot.statistics.log2FC_threshold",
    "plot.statistics.FDR_threshold",
    "plot.statistics.significance_metric"
  ],
  "palettes": {
    "Nature": {
      "up": "#E64B35",
      "down": "#4DBBD5",
      "ns": "#B0B0B0"
    },
    "Cell": {
      "up": "#BE1E2D",
      "down": "#0072B2",
      "ns": "#BBBBBB"
    },
    "Science": {
      "up": "#D55E00",
      "down": "#0072B2",
      "ns": "#999999"
    }
  },
  "rules": [
    {
      "id": "font_larger",
      "keywords": [
        "字体大",
        "字体增大",
        "字体加大",
        "加大字体",
        "放大字体",
        "字号增大",
        "字号大一点",
        "文字大一点",
        "字大一点",
        "字体大一点",
        "larger font",
        "increase font",
        "bigger font",
        "enlarge font"
      ],
      "parameter": "font_size",
      "operation": "increase",
      "value": 2,
      "confidence": 0.95
    },
    {
      "id": "font_smaller",
      "keywords": [
        "字体小",
        "字体减小",
        "字体缩小",
        "缩小字体",
        "字号减小",
        "文字小一点",
        "字小一点",
        "字体小一点",
        "smaller font",
        "decrease font"
      ],
      "parameter": "font_size",
      "operation": "decrease",
      "value": 1,
      "confidence": 0.9
    },
    {
      "id": "points_smaller",
      "keywords": ["点小一点", "点再小", "点小一些", "点减小", "缩小点", "点的大小小一点", "点的大小，小一点", "点的大小小一些", "smaller points", "points smaller"],
      "parameter": "point_size",
      "operation": "decrease",
      "value": 0.5,
      "confidence": 0.95
    },
    {
      "id": "points_larger",
      "keywords": ["点大一点", "点大一些", "点增大", "放大点", "点的大小大一点", "点的大小，大一点", "larger points", "points larger"],
      "parameter": "point_size",
      "operation": "increase",
      "value": 0.5,
      "confidence": 0.95
    },
    {
      "id": "thicken_axis_lines",
      "keywords": [
        "加粗边框",
        "边框加粗",
        "轴线加粗",
        "坐标轴加粗",
        "轴线粗一点",
        "线粗一点",
        "加粗轴线",
        "加粗坐标轴",
        "加粗外边框",
        "外边框加粗",
        "thicken axis",
        "thicker axis",
        "thicker lines"
      ],
      "parameter": "line_width",
      "operation": "increase",
      "value": 0.3,
      "confidence": 0.95,
      "ggplot": "theme(axis.line = element_line(linewidth=...)); NOT geom_hline/vline"
    },
    {
      "id": "thin_axis_lines",
      "keywords": ["轴线细一点", "边框细一点", "thinner axis"],
      "parameter": "line_width",
      "operation": "decrease",
      "value": 0.2,
      "confidence": 0.9,
      "ggplot": "theme(axis.line = element_line(linewidth=...))"
    },
    {
      "id": "thin_threshold_lines",
      "keywords": [
        "虚线变细",
        "内部虚线变细",
        "阈值线变细",
        "图内部的虚线变细",
        "参考线变细",
        "threshold thinner",
        "dashed thinner"
      ],
      "parameter": "threshold_line_width",
      "operation": "decrease",
      "value": 0.15,
      "confidence": 0.95,
      "ggplot": "geom_hline/geom_vline(linewidth=...)"
    },
    {
      "id": "thicken_threshold_lines",
      "keywords": ["虚线加粗", "阈值线加粗", "参考线加粗", "threshold thicker"],
      "parameter": "threshold_line_width",
      "operation": "increase",
      "value": 0.15,
      "confidence": 0.9,
      "ggplot": "geom_hline/geom_vline(linewidth=...)"
    },
    {
      "id": "outer_thick_inner_thin",
      "keywords": [
        "只加粗外边框，图内部的虚线变细",
        "外边框加粗虚线变细",
        "轴线加粗虚线变细"
      ],
      "parameter": "outer_thick_inner_thin",
      "operation": "preset",
      "value": {
        "geometry.line_width": "+0.3",
        "geometry.threshold_line_width": "-0.15"
      },
      "confidence": 0.98,
      "ggplot": "axis.line thicker; geom_hline/vline thinner"
    },
    {
      "id": "add_border",
      "keywords": [
        "全边框",
        "四周加边框",
        "四周加黑色边框",
        "增加四周边框",
        "加方框",
        "改成全边框",
        "panel border",
        "boxed panel",
        "full border"
      ],
      "parameter": "panel_border",
      "operation": "set",
      "value": "full",
      "confidence": 0.95,
      "ggplot": "theme(panel.border = element_rect(fill=NA))"
    },
    {
      "id": "remove_border",
      "keywords": ["去掉边框", "不要边框", "无边框", "去掉全边框", "不要全边框", "no border", "no panel border"],
      "parameter": "panel_border",
      "operation": "set",
      "value": "none",
      "confidence": 0.9,
      "ggplot": "theme(panel.border = element_blank())"
    },
    {
      "id": "show_major_grid",
      "keywords": ["加网格", "显示网格", "打开网格", "major grid", "show grid"],
      "parameter": "theme.grid",
      "operation": "set",
      "value": "major",
      "confidence": 0.85
    },
    {
      "id": "hide_grid",
